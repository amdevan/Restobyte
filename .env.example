# =============================================================================
# RestoByte - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# For Docker deployment, all values below are used by docker-compose.yml.
# =============================================================================

# Database
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=restobyte
POSTGRES_PORT=5432

# Authentication (REQUIRED - generate a strong random secret)
# Example: openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# Server Ports
BACKEND_PORT=3000
FRONTEND_PORT=80

# CORS (comma-separated origins, leave empty to allow all in production)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# URLs (set to your production domain)
BACKEND_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Frontend API URL (use /api when behind nginx reverse proxy)
VITE_API_URL=/api

# Native app API URL (for Capacitor mobile builds)
VITE_NATIVE_API_URL=https://api.yourdomain.com/api

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Reset superadmin password on next startup
# RESET_SUPERADMIN_PASSWORD=your-new-password
# RESET_SUPERADMIN_USERNAME=superadmin

# Optional: Seed demo users (NEVER set to true in production)
# SEED_DEMO_USERS=true

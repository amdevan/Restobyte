{
  "name": "restobyte-print-agent",
  "version": "1.0.0",
  "description": "Local Print Agent for RestoByte - enables silent printing without browser dialogs",
  "main": "dist/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && electron-builder",
    "build:dev": "tsc && electron-builder -c.directories.output=dist",
    "start": "electron ."
  },
  "author": "RestoByte",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ws": "^8.0.0",
    "systeminformation": "^5.21.0",
    "net": "^1.0.2",
    "axios": "^1.6.0",
    "keytar": "^7.9.0",
    "serialport": "^11.0.0",
    "@serialport/parser-readline": "^11.0.0"
  },
  "build": {
    "appId": "com.restobyte.printagent",
    "productName": "RestoByte Print Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "src/renderer/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main.js"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": ["dmg", "zip"],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": ["nsis", "zip"],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "assets/icon.png"
    }
  }
}

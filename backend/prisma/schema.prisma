generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String                @id @default(uuid())
  name               String
  address            String?
  phone              String?
  countryCode        String?
  currencyCode       String?
  subscriptionStatus String                @default("trialing")
  plan               String                @default("Basic")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  adminEmail         String?
  trialDays          Int?                  @default(14)
  trialEndsAt        DateTime?
  outlets            Outlet[]
  payments           Payment[]
  roles              Role[]
  invoices           SubscriptionInvoice[]
  loginHistory       TenantLoginHistory[]
  users              User[]
}

model Outlet {
  id                      String    @id @default(uuid())
  name                    String
  tenantId                String
  address                 String?
  phone                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  slug                    String    @unique
  email                   String?
  fonepayCurrency         String?
  fonepayIsEnabled        Boolean   @default(false)
  fonepayMerchantCode     String?
  fonepayTerminalId       String?
  logoUrl                 String?
  outletType              String    @default("Restaurant")
  plan                    String?
  planExpiryDate          DateTime?
  restaurantName          String?
  subscriptionStatus      String?
  taxes                   Json?
  whatsappDefaultMessage  String?
  whatsappNumber          String?
  whatsappOrderingEnabled Boolean   @default(false)
  invoices                Invoice[]
  orders                  Order[]
  tenant                  Tenant    @relation(fields: [tenantId], references: [id])
  users                   User[]
}

model Category {
  id          String     @id @default(uuid())
  name        String
  outletId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  description String?
  imageUrl    String?
  menuItems   MenuItem[]
}

model MenuItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Float
  categoryId   String
  imageUrl     String?
  isAvailable  Boolean     @default(true)
  isVegetarian Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  category     Category    @relation(fields: [categoryId], references: [id])
  OrderItem    OrderItem[]
  variations   Variation[]
}

model Variation {
  id         String   @id @default(uuid())
  name       String
  price      Float
  menuItemId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}

model Table {
  id                    String        @id @default(uuid())
  name                  String
  capacity              Int
  status                String        @default("Free")
  outletId              String
  areaFloorId           String?
  notes                 String?
  assistanceRequested   Boolean       @default(false)
  assistanceRequestedAt DateTime?
  foodReady             Boolean       @default(false)
  occupiedSince         DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  reservations          Reservation[]
}

model Customer {
  id                  String           @id @default(uuid())
  name                String
  email               String?
  phone               String?
  address             String?
  dob                 DateTime?
  companyName         String?
  vatPan              String?
  dueAmount           Float            @default(0)
  outletId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  userId              String?          @unique
  billingAddress      String?
  lastPaymentDate     DateTime?
  totalPaidAmount     Float            @default(0)
  totalPurchaseAmount Float            @default(0)
  user                User?            @relation(fields: [userId], references: [id])
  invoices            Invoice[]
  orders              Order[]
  paymentHistories    PaymentHistory[]
  reservations        Reservation[]
}

model Order {
  id          String      @id @default(uuid())
  createdAt   DateTime    @default(now())
  customerId  String?
  total       Float       @default(0)
  status      String      @default("PENDING")
  outletId    String?
  saleData    Json?
  tableNumber String?
  invoices    Invoice[]
  customer    Customer?   @relation(fields: [customerId], references: [id])
  outlet      Outlet?     @relation(fields: [outletId], references: [id])
  items       OrderItem[]
}

model OutletAppData {
  id        String   @id @default(uuid())
  outletId  String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, key])
}

model UserAppData {
  id        String   @id @default(uuid())
  userId    String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model GlobalAppData {
  id        String   @id @default(uuid())
  key       String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Float
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
}

model User {
  id           String               @id @default(uuid())
  username     String               @unique
  password     String
  roleId       String?
  outletId     String?
  tenantId     String?
  isActive     Boolean              @default(true)
  isSuperAdmin Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  outletIds    Json?
  email        String?              @unique
  phone        String?              @unique
  customer     Customer?
  loginHistory TenantLoginHistory[]
  outlet       Outlet?              @relation(fields: [outletId], references: [id])
  tenant       Tenant?              @relation(fields: [tenantId], references: [id])
}

model Currency {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  symbol       String
  exchangeRate Float
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlanDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  price       Float
  period      String   @default("yearly")
  features    Json?
  featureKeys Json?
  limits      Json?
  trialDays   Int      @default(14)
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String   @id
  name        String
  permissions Json?
  tenantId    String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

model Payment {
  id        String               @id @default(uuid())
  tenantId  String
  amount    Float
  status    String               @default("paid")
  method    String?
  notes     String?
  createdAt DateTime             @default(now())
  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  invoice   SubscriptionInvoice?
}

model SubscriptionInvoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  tenantId      String
  paymentId     String?   @unique
  amount        Float
  currencyCode  String    @default("NPR")
  status        String    @default("issued")
  method        String?
  notes         String?
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payment       Payment?  @relation(fields: [paymentId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
}

model Invoice {
  id               String           @id @default(uuid())
  invoiceNumber    String           @unique
  orderId          String
  customerId       String?
  outletId         String
  totalAmount      Float            @default(0)
  paidAmount       Float            @default(0)
  dueAmount        Float            @default(0)
  paymentStatus    String           @default("DUE")
  paymentMethod    String?
  items            Json?
  taxAmount        Float            @default(0)
  discountAmount   Float            @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  paidAt           DateTime?
  customer         Customer?        @relation(fields: [customerId], references: [id])
  order            Order            @relation(fields: [orderId], references: [id])
  outlet           Outlet           @relation(fields: [outletId], references: [id])
  paymentHistories PaymentHistory[]
}

model PaymentHistory {
  id         String    @id @default(uuid())
  invoiceId  String
  customerId String?
  amount     Float
  method     String
  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
  invoice    Invoice   @relation(fields: [invoiceId], references: [id])
}

model TenantLoginHistory {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  username    String
  ipAddress   String?
  userAgent   String?
  deviceLabel String?
  loginType   String   @default("password")
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])
}

model Lead {
  id        String     @id @default(uuid())
  name      String
  email     String?
  phone     String?
  company   String?
  source    String?
  stage     String     @default("New")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notes     LeadNote[]
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  content   String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model SaasEmailConfig {
  id         String   @id @default(uuid())
  env        String   @unique @default("dev")
  provider   String?
  smtpHost   String?
  smtpPort   Int?
  smtpSecure Boolean?
  smtpUser   String?
  smtpPass   String?
  fromName   String?
  fromEmail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SaasWebsiteContent {
  id        String   @id @default(uuid())
  env       String   @unique @default("default")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id              String   @id @default(uuid())
  customerId      String
  tableId         String?
  outletId        String
  reservationTime DateTime
  numberOfGuests  Int
  status          String   @default("PENDING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  customer        Customer @relation(fields: [customerId], references: [id])
  table           Table?   @relation(fields: [tableId], references: [id])
}

model Printer {
  id                String   @id @default(uuid())
  name              String
  type              String   @default("Receipt")
  interfaceType     String   @default("Network (IP/Ethernet)")
  isActive          Boolean  @default(true)
  ipAddress         String?
  port              String?
  usbPath           String?
  bluetoothMac      String?
  serialPort        String?
  baudRate          Int?
  paperSize         String?  @default("80mm")
  printerModel      String?
  timeoutMs         Int?     @default(5000)
  retries           Int?     @default(3)
  autoPrintReceipt  Boolean  @default(false)
  autoPrintKOT      Boolean  @default(false)
  autoPrintLabel    Boolean  @default(false)
  notes             String?
  outletId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  autoPrintBOT      Boolean  @default(false)
  autoPrintDelivery Boolean  @default(false)
}
